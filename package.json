{
  "name": "pakistan-mcp",
  "version": "1.0.0",
  "description": "MCP server that gives Claude, Cursor and other AI assistants accurate Pakistan tools: FBR salary tax, CNIC/phone/IBAN/NTN checks, PKR lakh/crore formatting, Roman Urdu to Urdu, and Urdu & Hijri dates. Runs locally, no API keys.",
  "type": "module",
  "main": "./src/server.js",
  "exports": {
    ".": "./src/server.js"
  },
  "bin": {
    "pakistan-mcp": "bin/pakistan-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/pakistan-mcp.js",
    "test": "node --test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai",
    "pakistan",
    "urdu",
    "fbr",
    "income-tax",
    "cnic",
    "iban",
    "roman-urdu"
  ],
  "author": "mubasher1111",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mubasher1111/pakistan-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/mubasher1111/pakistan-mcp/issues"
  },
  "homepage": "https://zexcart.site/pakistan-mcp/",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "pakistan-toolkit": "^1.0.1",
    "urdu-toolkit": "^1.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0"
  }
}
